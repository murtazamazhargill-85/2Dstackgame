#include "game.h"
using namespace sf;

bool spaceWasDown = false;   // stops one key press from dropping many blocks

void handleInput(RenderWindow& window)
{
    // Close button
    while (auto event = window.pollEvent())
    {
        if (event->is<Event::Closed>())
            window.close();
    }

    // Escape = quit
    if (Keyboard::isKeyPressed(Keyboard::Key::Escape))
        window.close();

    // R = restart
    if (Keyboard::isKeyPressed(Keyboard::Key::R))
        resetGame();

    // Space = drop the block (only once per press)
    if (Keyboard::isKeyPressed(Keyboard::Key::Space))
    {
        if (!spaceWasDown && !isGameOver && !isFalling)
            isFalling = true;
        spaceWasDown = true;
    }
    else
    {
        spaceWasDown = false;
    }
}

int main()
{
    RenderWindow window(VideoMode({ WINDOW_W, WINDOW_H }), "Stack");
    window.setFramerateLimit(60);

    loadAssets();
    resetGame();

    while (window.isOpen())
    {
        handleInput(window);
        updateGame();
        drawGame(window);
    }
    return 0;
}
