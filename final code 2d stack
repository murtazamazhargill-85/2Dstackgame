// [FILE HANDLING 1]: Load Settings from stack_settings.txt
void loadSettingsFromFile()
{
    std::ifstream in(SETTINGS_FILE);
    if (in >> WINDOW_W >> WINDOW_H >> BLOCK_HEIGHT >> START_WIDTH >> SLIDE_SPEED >> DROP_SPEED >> PERFECT_TOLERANCE)
    {
        // Successfully loaded custom settings
    }
    else
    {
        // Create default file if missing
        std::ofstream out(SETTINGS_FILE);
        if (out)
            out << WINDOW_W << " " << WINDOW_H << " " << BLOCK_HEIGHT << " "
            << START_WIDTH << " " << SLIDE_SPEED << " " << DROP_SPEED << " " << PERFECT_TOLERANCE << "\n";
    }
}

// [FILE HANDLING 2]: Load Theme Colors from stack_theme.txt
void loadThemeFromFile()
{
    std::ifstream in(THEME_FILE);
    int r1, g1, b1, r2, g2, b2, r3, g3, b3, r4, g4, b4;
    if (in >> r1 >> g1 >> b1 >> r2 >> g2 >> b2 >> r3 >> g3 >> b3 >> r4 >> g4 >> b4)
    {
        dayTop = sf::Color((std::uint8_t)r1, (std::uint8_t)g1, (std::uint8_t)b1);
        dayBot = sf::Color((std::uint8_t)r2, (std::uint8_t)g2, (std::uint8_t)b2);
        nightTop = sf::Color((std::uint8_t)r3, (std::uint8_t)g3, (std::uint8_t)b3);
        nightBot = sf::Color((std::uint8_t)r4, (std::uint8_t)g4, (std::uint8_t)b4);
    }
    else
    {
        std::ofstream out(THEME_FILE);
        if (out)
        {
            out << "120 190 255\n220 240 255\n10 10 40\n70 40 110\n";
        }
    }
}

// [FILE HANDLING 3]: Load & Save Lifetime Stats in stack_stats.txt
void loadLifetimeStats()
{
    std::ifstream in(STATS_FILE);
    if (in)
    {
        in >> totalGamesPlayed >> totalBlocksEver >> totalPerfectsEver >> allTimeMaxCombo;
    }
}

void saveLifetimeStats()
{
    totalGamesPlayed++;
    totalBlocksEver += (blockCount - 1);
    totalPerfectsEver += perfectCount;
    if (maxCombo > allTimeMaxCombo) allTimeMaxCombo = maxCombo;

    std::ofstream out(STATS_FILE);
    if (out)
    {
        out << totalGamesPlayed << " " << totalBlocksEver << " "
            << totalPerfectsEver << " " << allTimeMaxCombo << "\n";
    }
}

// [FILE HANDLING 4]: Save & Load Current Tower State in stack_savegame.txt
void saveGameStateToFile()
{
    std::ofstream out(SAVEGAME_FILE);
    if (!out) return;

    out << 1 << "\n"; // flag indicating valid save exists
    out << blockCount << " " << plusScore << " " << comboCount << " "
        << maxCombo << " " << perfectCount << " " << curW << "\n";

    for (int i = 0; i < blockCount; i++)
    {
        out << towerX[i] << " " << towerW[i] << "\n";
    }
    hasSavedGame = true;
}

bool loadGameStateFromFile()
{
    std::ifstream in(SAVEGAME_FILE);
    int validFlag = 0;
    if (!(in >> validFlag) || validFlag != 1)
        return false;

    in >> blockCount >> plusScore >> comboCount >> maxCombo >> perfectCount >> curW;
    for (int i = 0; i < blockCount; i++)
    {
        in >> towerX[i] >> towerW[i];
    }

    curX = 0;
    curY = DROP_HEIGHT;
    curSpeed = SLIDE_SPEED;
    isFalling = false;
    isGameOver = false;
    newBestFlag = false;
    resultSaved = false;
    plusParticles.clear();
    plusDebris.clear();
    plusTexts.clear();

    return true;
}

void clearSavedGameFile()
{
    std::ofstream out(SAVEGAME_FILE);
    if (out) out << 0 << "\n";
    hasSavedGame = false;
}

// [FILE HANDLING 5]: Append Gameplay Logs to stack_log.txt
void logEventToFile(const std::string& message)
{
    std::ofstream out(GAMELOG_FILE, std::ios::app);
    if (out)
    {
        out << "[Tick " << plusTick << "] " << message << "\n";
    }
}

// Existing High Score File Handling
void loadBestScore()
{
    std::ifstream in(HIGHSCORE_FILE);
    if (in) in >> bestScore;
    if (bestScore < 0) bestScore = 0;
    loadLifetimeStats();

    // Also check if a saved game exists
    std::ifstream saveCheck(SAVEGAME_FILE);
    int flag = 0;
    if (saveCheck >> flag && flag == 1) hasSavedGame = true;

    bestLoaded = true;
}

void saveBestScore()
{
    std::ofstream out(HIGHSCORE_FILE);
    if (out) out << bestScore;
}

void saveScore()
{
    std::ofstream out(SCORES_FILE, std::ios::app);
    if (out)
        out << plusScore << '\n';
}

