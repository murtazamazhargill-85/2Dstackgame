void loadAssets()
{
    font.openFromFile("C:/Windows/Fonts/arial.ttf");
    loadSettingsFromFile(); // Reads stack_settings.txt
    loadThemeFromFile();    // Reads stack_theme.txt
}

void resetGame()
{
    towerX[0] = (WINDOW_W - START_WIDTH) / 2.f;
    towerW[0] = START_WIDTH;
    blockCount = 1;

    curX = 0;
    curW = START_WIDTH;
    curY = DROP_HEIGHT;
    curSpeed = SLIDE_SPEED;

    isFalling = false;
    isGameOver = false;
}

void slideBlock()
{
    curX += curSpeed;

    if (curX + curW >= WINDOW_W)
        curSpeed = -SLIDE_SPEED;
    if (curX <= 0)
        curSpeed = SLIDE_SPEED;
}

void landBlock()
{
    curY = 0;
    isFalling = false;

    int top = blockCount - 1;

    float overlapStart = max(curX, towerX[top]);
    float overlapEnd = min(curX + curW, towerX[top] + towerW[top]);

    if (overlapEnd <= overlapStart)
    {
        isGameOver = true;
        logEventToFile("Block missed! Game Over at block #" + std::to_string(blockCount));
    }
    else
    {
        towerX[blockCount] = overlapStart;
        towerW[blockCount] = overlapEnd - overlapStart;

        curX = 0;
        curW = towerW[blockCount];
        curY = DROP_HEIGHT;
        blockCount++;

        logEventToFile("Block #" + std::to_string(blockCount - 1) + " landed. New width: " + std::to_string((int)curW));
    }
}

void updateGame()
{
    if (!isGameOver && !isFalling)
        slideBlock();

    if (isFalling)
    {
        curY -= DROP_SPEED;
        if (curY <= 0)
            landBlock();
    }
}

void handleInput(RenderWindow& window)
{
    while (auto event = window.pollEvent())
    {
        if (event->is<Event::Closed>())
            window.close();
    }

    if (Keyboard::isKeyPressed(Keyboard::Key::Escape))
        window.close();

    if (Keyboard::isKeyPressed(Keyboard::Key::R))
        resetGame();

    if (Keyboard::isKeyPressed(Keyboard::Key::Space))
    {
        if (!spaceWasDown && !isGameOver && !isFalling)
            isFalling = true;
        spaceWasDown = true;
    }
    else
    {
        spaceWasDown = false;
    }
}

// =========================================================================
// HELPERS & EFFECTS
// =========================================================================

sf::Color plusHSV(float h, float s, float v)
{
    float c = v * s;
    float x = c * (1.f - std::fabs(std::fmod(h / 60.f, 2.f) - 1.f));
    float m = v - c;
    float r = 0, g = 0, b = 0;
    int i = ((int)(h / 60.f)) % 6;
    switch (i)
    {
    case 0: r = c; g = x; b = 0; break;
    case 1: r = x; g = c; b = 0; break;
    case 2: r = 0; g = c; b = x; break;
    case 3: r = 0; g = x; b = c; break;
    case 4: r = x; g = 0; b = c; break;
    default: r = c; g = 0; b = x; break;
    }
    return sf::Color((std::uint8_t)((r + m) * 255), (std::uint8_t)((g + m) * 255),
        (std::uint8_t)((b + m) * 255));
}

sf::Color plusLerp(sf::Color a, sf::Color b, float t)
{
    if (t < 0) t = 0;
    if (t > 1) t = 1;
    return sf::Color((std::uint8_t)(a.r + (b.r - a.r) * t),
        (std::uint8_t)(a.g + (b.g - a.g) * t),
        (std::uint8_t)(a.b + (b.b - a.b) * t));
}

sf::Color plusShade(sf::Color c, float f, int alpha = 255)
{
    return sf::Color((std::uint8_t)std::min(255.f, c.r * f),
        (std::uint8_t)std::min(255.f, c.g * f),
        (std::uint8_t)std::min(255.f, c.b * f),
        (std::uint8_t)alpha);
}

sf::Color plusBlockColor(int index)
{
    return plusHSV((float)((index * 17) % 360), 0.55f, 0.95f);
}

int plusScroll()
{
    return (blockCount > VISIBLE_ROWS) ? blockCount - VISIBLE_ROWS : 0;
}

void drawTextPlus(sf::RenderWindow& window, const std::string& str, unsigned int size,
    float x, float y, sf::Color color, bool centered = true, bool shadow = true)
{
    sf::Text t(font, str, size);
    if (centered)
    {
        sf::FloatRect b = t.getLocalBounds();
        t.setOrigin({ b.position.x + b.size.x / 2.f, b.position.y + b.size.y / 2.f });
    }
    if (shadow)
    {
        t.setFillColor(sf::Color(0, 0, 0, (std::uint8_t)(color.a * 0.45f)));
        t.setPosition({ x + 2.f, y + 2.f });
        window.draw(t);
    }
    t.setFillColor(color);
    t.setPosition({ x, y });
    window.draw(t);
}

void spawnBurst(float x, float y, int count, sf::Color color, float power = 3.f)
{
    for (int i = 0; i < count; i++)
    {
        PlusParticle p;
        p.x = x; p.y = y;
        float angle = (rand() % 360) * 3.14159f / 180.f;
        float sp = (rand() % 100) / 100.f * power + 0.5f;
        p.vx = std::cos(angle) * sp;
        p.vy = std::sin(angle) * sp - 1.5f;
        p.life = 30.f + (float)(rand() % 30);
        p.maxLife = p.life;
        p.size = 3.f + (float)(rand() % 4);
        p.color = color;
        plusParticles.push_back(p);
    }
}

void spawnFloatText(const std::string& s, float x, float y, sf::Color c, unsigned int size = 28)
{
    PlusFloatText t;
    t.text = s;
    t.x = x;
    t.y = y;
    t.life = 60.f;
    t.color = c;
    t.size = size;
    plusTexts.push_back(t);
}

void addDebrisPlus(float x, float y, float w, float vx, float life, sf::Color color)
{
    PlusDebris d;
    d.x = x;
    d.y = y;
    d.w = w;
    d.vx = vx;
    d.vy = 0.f;
    d.life = life;
    d.color = color;
    plusDebris.push_back(d);
}

void updateEffectsPlus()
{
    for (auto& p : plusParticles) { p.x += p.vx; p.y += p.vy; p.vy += 0.15f; p.life--; }
    plusParticles.erase(std::remove_if(plusParticles.begin(), plusParticles.end(),
        [](const PlusParticle& p) { return p.life <= 0; }), plusParticles.end());

    for (auto& d : plusDebris) { d.x += d.vx; d.y += d.vy; d.vy += 0.6f; d.life--; }
    plusDebris.erase(std::remove_if(plusDebris.begin(), plusDebris.end(),
        [](const PlusDebris& d) { return d.life <= 0 || d.y > WINDOW_H + 50; }), plusDebris.end());

    for (auto& t : plusTexts) { t.y -= 0.8f; t.life--; }
    plusTexts.erase(std::remove_if(plusTexts.begin(), plusTexts.end(),
        [](const PlusFloatText& t) { return t.life <= 0; }), plusTexts.end());
}

