void resetPlus()
{
    plusScore = 0;
    comboCount = 0;
    maxCombo = 0;
    perfectCount = 0;
    newBestFlag = false;
    resultSaved = false;
    plusParticles.clear();
    plusDebris.clear();
    plusTexts.clear();
}

void handleInputPlus(sf::RenderWindow& window)
{
    bool fallingBefore = isFalling;

    handleInput(window);

    bool spaceNow = sf::Keyboard::isKeyPressed(sf::Keyboard::Key::Space);
    bool rNow = sf::Keyboard::isKeyPressed(sf::Keyboard::Key::R);
    bool pNow = sf::Keyboard::isKeyPressed(sf::Keyboard::Key::P);
    bool cNow = sf::Keyboard::isKeyPressed(sf::Keyboard::Key::C);

    // Restart
    if (rNow && !plusRWas)
    {
        resetGame();
        resetPlus();
        plusState = PLUS_PLAY;
        isFalling = false;
        logEventToFile("Game restarted by user.");
    }

    // Pause toggle + Auto-save tower state to stack_savegame.txt
    if (pNow && !plusPWas)
    {
        if (plusState == PLUS_PLAY)
        {
            plusState = PLUS_PAUSED;
            saveGameStateToFile(); // [FILE HANDLING 4] Save tower on pause
            logEventToFile("Game paused and saved to stack_savegame.txt");
        }
        else if (plusState == PLUS_PAUSED)
        {
            plusState = PLUS_PLAY;
            logEventToFile("Game resumed.");
        }
    }

    // Continue saved game from menu using 'C'
    if (plusState == PLUS_MENU && hasSavedGame && cNow && !plusCWas)
    {
        if (loadGameStateFromFile()) // [FILE HANDLING 4] Load tower from file
        {
            plusState = PLUS_PLAY;
            logEventToFile("Loaded saved tower from stack_savegame.txt");
        }
    }

    // Start new game from menu
    if (plusState == PLUS_MENU && spaceNow && !plusSpaceWas)
    {
        resetGame();
        resetPlus();
        plusState = PLUS_PLAY;
        logEventToFile("New game started.");
    }

    if (plusState == PLUS_MENU || plusState == PLUS_PAUSED)
        isFalling = fallingBefore && plusState == PLUS_PAUSED;

    plusSpaceWas = spaceNow;
    plusRWas = rNow;
    plusPWas = pNow;
    plusCWas = cNow;
}

void updateGamePlus()
{
    plusTick++;
    if (!bestLoaded) loadBestScore();
    updateEffectsPlus();

    if (plusState != PLUS_PLAY) return;

    if (!isGameOver && !isFalling)
    {
        int level = (blockCount - 1) / BLOCKS_PER_LEVEL;
        float extra = std::min(level * 0.5f, MAX_EXTRA_SPEED);
        curX += (curSpeed > 0 ? extra : -extra);
        if (curX < 0) curX = 0;
        if (curX + curW > WINDOW_W) curX = WINDOW_W - curW;
    }

    bool  landing = isFalling && !isGameOver && (curY - DROP_SPEED <= 0);
    float pX = curX, pW = curW;
    int   topIdx = blockCount - 1;
    float tX = towerX[topIdx], tW = towerW[topIdx];
    int   before = blockCount;

    updateGame();

    if (landing)
    {
        int scroll = plusScroll();
        if (isGameOver)
        {
            float y = WINDOW_H - (before + 1 - scroll) * BLOCK_HEIGHT;
            addDebrisPlus(pX, y, pW, (float)(rand() % 3 - 1) * 1.5f, 90.f, plusBlockColor(before));
            comboCount = 0;
        }
        else if (blockCount > before)
        {
            int   idx = blockCount - 1;
            bool  perfect = std::fabs(pX - tX) <= PERFECT_TOLERANCE;
            float y = WINDOW_H - (idx + 1 - scroll) * BLOCK_HEIGHT;

            if (perfect)
            {
                towerX[idx] = tX;
                towerW[idx] = tW;
                comboCount++;
                perfectCount++;
                if (comboCount > maxCombo) maxCombo = comboCount;

                if (comboCount >= 3)
                {
                    float g = std::min(PERFECT_GROW, START_WIDTH - towerW[idx]);
                    if (g > 0)
                    {
                        towerX[idx] -= g / 2;
                        towerW[idx] += g;
                        if (towerX[idx] < 0) towerX[idx] = 0;
                        if (towerX[idx] + towerW[idx] > WINDOW_W)
                            towerX[idx] = WINDOW_W - towerW[idx];
                    }
                }
                curW = towerW[idx];

                plusScore += 1 + std::min(comboCount, 5);
                spawnBurst(towerX[idx] + towerW[idx] / 2, y, 30, sf::Color(255, 215, 0), 4.f);
                spawnFloatText(comboCount >= 2 ? "PERFECT x" + std::to_string(comboCount) : std::string("PERFECT!"),
                    WINDOW_W / 2.f, y - 20, sf::Color(255, 220, 60));
                logEventToFile("PERFECT drop! Combo x" + std::to_string(comboCount));
            }
            else
            {
                comboCount = 0;
                plusScore += 1;
                float oS = towerX[idx], oE = towerX[idx] + towerW[idx];

                if (pX < oS)
                    addDebrisPlus(pX, y, oS - pX, -1.f, 80.f, plusBlockColor(idx));
                if (pX + pW > oE)
                    addDebrisPlus(oE, y, pX + pW - oE, 1.f, 80.f, plusBlockColor(idx));

                spawnBurst(towerX[idx] + towerW[idx] / 2, y, 8, plusShade(plusBlockColor(idx), 1.2f), 2.f);
            }
        }
    }

    // Game over -> save all records to files
    if (isGameOver && !resultSaved)
    {
        resultSaved = true;
        plusState = PLUS_OVER;
        saveScore();          // Existing score history file
        saveLifetimeStats();  // [FILE HANDLING 3] Save lifetime stats
        clearSavedGameFile(); // [FILE HANDLING 4] Clear active save file
        logEventToFile("Final Score: " + std::to_string(plusScore) + " | Best: " + std::to_string(bestScore));

        if (plusScore > bestScore)
        {
            bestScore = plusScore;
            newBestFlag = true;
            saveBestScore();
        }
    }
}

